{
  "expo": {
    "name": "Harmonie van Horst",
    "slug": "harmonie-van-horst",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "hoh",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.harmonievanhorst.app"
    },
    "android": {
      "package": "com.harmonievanhorst.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
